# ╔══════════════════════════════════════════════════════════════════╗
# ║  UND Dashboard — production (Vercel → Settings → Environment)     ║
# ╚══════════════════════════════════════════════════════════════════╝

# The bot API, reachable through the Cloudflare Tunnel (include /api/v1).
# Server-side only: the browser calls /api/bot on this deployment instead.
API_URL=https://api.yourdomain.com/api/v1

# Must be identical to DASHBOARD_API_KEY in bot/.env
DASHBOARD_API_KEY=

# Public URL of this deployment (no trailing slash)
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=

# Discord OAuth2 app (same application as the bot)
# Redirect URI: https://your-app.vercel.app/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your Discord user ID (comma separated for several admins)
NEXT_PUBLIC_ADMIN_IDS=

NEXT_PUBLIC_BRAND_NAME="UND"
NEXT_PUBLIC_BRAND_NAME_WORD="UND"
